# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual envs
venv/
.venv/
env/

# OS / editor cruft
.DS_Store
.AppleDouble
.LSOverride
._*
.idea/
.vscode/

# PyInstaller output
bin/build/
bin/dist/

# PlatformIO build output. Object files and link maps for the old
# firmware project, regenerated by any build.
.pio/

# Ready-to-run apps. Hundreds of MB each, far past GitHub's file
# limits. The instruction files inside stay tracked.
builds/Mac/Finger Rehab.app/
builds/Windows/Finger Rehab.exe
builds/Windows/Finger Rehab/

# The EEG lab package's build products. The exe is hundreds of MB,
# far past the nightly backup's 99 MB guard; eeg_lab.yaml is a
# build-time copy of config/eeg_lab.yaml and source/ a copy of the
# game, and committing either would fork it from its source.
# scripts/build_lab_package.py regenerates all three.
docs/lab_package/*.exe
docs/lab_package/eeg_lab.yaml
docs/lab_package/source/

# Firmware images and the bundled avrdude. Build products of
# builds/build_firmware.py and builds/fetch_avrdude.py, rebuilt by CI on
# every push. The hexes would fork from their source the moment anyone
# committed one, and avrdude is a 6 MB third-party binary.
assets/firmware/*
!assets/firmware/README.txt
tools/avrdude/*/
bin/dl/

# Per-session output. Don't publish.
sessions/

# Written by the Settings screen, per user.
config/user_settings.yaml

# The Patterns sequence file a researcher loaded on this machine, its
# pointer, and the drop folder with the import archive. Per machine,
# not part of the app. config/pattern_sequence_template.yaml is the
# committed blank one and stays tracked.
config/pattern_sequence.yaml
config/pattern_sequence.json
config/pattern_sequences/

# Notebook output. Regenerated every run, so it does not belong in git.
analysis/figures/
analysis/*.csv
analysis/.ipynb_checkpoints/

# Same output when the notebook is run from the repo root instead of from
# analysis/. A set of these got committed once and went stale, which is worse
# than useless: they were figures of the uncorrected numbers sitting where
# someone might pick them up for the report.
/figures/
docs/research/rayan/__pycache__/
builds/Windows/*.zip
