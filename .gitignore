# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual envs
venv/
.venv/
env/

# OS / editor cruft
.DS_Store
.AppleDouble
.LSOverride
._*
.idea/
.vscode/
.pytest_cache/

# PyInstaller working folders
app/bin/build/
app/bin/dist/

# PlatformIO build output, regenerated by any firmware build.
.pio/

# Ready-to-run apps. Hundreds of MB each, far past GitHub's limits.
app/builds/Mac/*.app/
app/builds/Mac/*.dmg
app/builds/Windows/*.exe
app/builds/Windows/Finger Rehab/
app/builds/Windows/*.zip

# The two things people are handed. Both are build products of the same
# commit, both are hundreds of MB, and both are past the nightly
# backup's 99 MB guard.
Installers/Windows/*.exe
Installers/macOS/*.dmg

# The lab folder's build products. eeg_lab.yaml is a copy of
# app/config/eeg_lab.yaml and source/ a copy of the game, so committing
# either would fork it from its source.
# app/scripts/build_lab_package.py regenerates all three.
EEG_Lab/*.exe
EEG_Lab/eeg_lab.yaml
EEG_Lab/source/

# Firmware images and the bundled avrdude. Build products of
# app/builds/build_firmware.py and app/builds/fetch_avrdude.py, rebuilt
# by CI on every push.
app/assets/firmware/*
!app/assets/firmware/README.md
app/tools/avrdude/*/
archive/dl/

# Per-session output. Not published.
sessions/

# Written by the Settings screen, per user.
app/config/user_settings.yaml
# The trigger box port picked in the game on this machine.
app/config/eeg_port.yaml

# The Patterns sequence file a researcher loaded on this machine and its
# pointer. Per machine, not part of the app.
# app/config/pattern_sequence_template.yaml is the blank one and stays.
app/config/pattern_sequence.yaml
app/config/pattern_sequence.json
app/config/pattern_sequences/

# Notebook output. Regenerated every run.
analysis/figures/
analysis/*.csv
analysis/.ipynb_checkpoints/
/figures/
app/docs/research/rayan/__pycache__/
