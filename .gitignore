# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual envs
venv/
.venv/
env/

# OS / editor cruft
.DS_Store
.AppleDouble
.LSOverride
._*
.idea/
.vscode/

# PyInstaller output
bin/build/
bin/dist/

# Ready-to-run apps. Hundreds of MB each, far past GitHub's file
# limits. The instruction files inside stay tracked.
builds/Mac/Finger Rehab.app/
builds/Windows/Finger Rehab.exe
builds/Windows/Finger Rehab/

# Per-session output. Don't publish.
sessions/

# Written by the Settings screen, per user.
config/user_settings.yaml

# Notebook output. Regenerated every run, so it does not belong in git.
analysis/figures/
analysis/*.csv
analysis/.ipynb_checkpoints/

# Same output when the notebook is run from the repo root instead of from
# analysis/. A set of these got committed once and went stale, which is worse
# than useless: they were figures of the uncorrected numbers sitting where
# someone might pick them up for the report.
/figures/
